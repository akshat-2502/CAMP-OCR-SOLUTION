{
  "version": 3,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "env": {
    "NODE_ENV": "production"
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "server.ts",
      "use": "@vercel/node",
      "config": {
        "runtime": "nodejs20.x",
        "memory": 1024,
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.ts"
    },
    {
      "src": "/(.*)",

      "dest": "/dist/index.html"

      "dest": "/dist/$1"
    }
  ],

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/dist/index.html"

    }
  ]
}
